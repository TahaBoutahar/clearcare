# Copy the relevant settings into the root .env alongside the existing AI settings.
CLEARCARE_CLINICIAN=Dr Alex Morgan
# Optional for local use. Required by the app on a non-loopback interface.
CLEARCARE_APP_PASSWORD=
# Default: .clearcare-data/ in the repository. Use persistent private storage when hosting.
# CLEARCARE_DATA_DIR=/private/path/to/clearcare
# Reachable base URL, without a query/fragment. HTTPS required outside localhost.
# CLEARCARE_PUBLIC_URL=https://clearcare.example.org

# Email is optional. The app uses STARTTLS (587) or SMTP over TLS (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
