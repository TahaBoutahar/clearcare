# Demo app settings (copy to .env). The AI provider, model and API keys come from the
# project's .env one folder up; set them here only to use something different for the demo.

# PIN asked on the phone. Strongly recommended; required with --tunnel (one is made up if empty).
DEMO_PIN=

# Port on this computer
DEMO_PORT=8443

# Speech-to-text model for dictation: base (fast) | small (better French) | medium
WHISPER_MODEL_SIZE=small
