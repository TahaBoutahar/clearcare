# Settings for ClearCare (the rx command).
# Copy this file to .env and edit it. Real environment variables override these values,
# and command-line flags (-p, -m) override both.

# Which AI to use: amd | ollama | openrouter
LLM_PROVIDER=ollama

# Optional: a specific model for that provider (leave empty for the provider's default)
LLM_MODEL=

# AMD Developer Cloud (needed when LLM_PROVIDER=amd)
AMD_API_KEY=
# API address and model, as shown in the AMD console (leave empty for the defaults)
AMD_BASE_URL=
AMD_MODEL=
# Spending guard: tokens per AMD day (resets 10:00 Morocco time); 0 or empty = no limit.
# The daily budget is shared by everyone using the same key.
AMD_DAILY_TOKEN_LIMIT=100000
# When today's AMD budget is used up: continue with this provider instead (empty = stop with a message)
AMD_FALLBACK=ollama

# Second model that rates every result from 0 to 5. Use a different model from the writer
# (empty = same provider/model as above, a weaker check)
JUDGE_PROVIDER=amd
JUDGE_MODEL=MiMo-V2.6-Flash

# OpenRouter free tier (needed when LLM_PROVIDER=openrouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Ollama model (when LLM_PROVIDER=ollama)
# OLLAMA_MODEL=hf.co/NousResearch/Hermes-3-Llama-3.1-8B-GGUF:Q4_K_M

# Speech-to-text model size for voice recordings: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small
