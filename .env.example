# Settings for the prescription explainer command.
# Copy this file to .env and edit it. Real environment variables override these values,
# and command-line flags (-p, -m) override both.

# Which AI to use: amd | ollama | openrouter
LLM_PROVIDER=ollama

# Optional: a specific model for that provider (leave empty for the provider's default)
LLM_MODEL=

# AMD Developer Cloud (needed when LLM_PROVIDER=amd)
AMD_API_KEY=

# OpenRouter free tier (needed when LLM_PROVIDER=openrouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Ollama model (when LLM_PROVIDER=ollama)
# OLLAMA_MODEL=hf.co/NousResearch/Hermes-3-Llama-3.1-8B-GGUF:Q4_K_M

# Speech-to-text model size for voice recordings: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small
